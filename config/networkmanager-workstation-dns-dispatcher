#!/usr/bin/env bash
set -Eeuo pipefail

# NetworkManager and Netplan may still publish DHCP DNS servers to
# systemd-resolved even with ignore-auto-dns enabled.  They must never be a
# default route while loopback AdGuard owns the global ~. route.
case ${2:-} in
    up|dhcp4-change|dhcp6-change) ;;
    *) exit 0 ;;
esac

[[ ${1:-} == '@UPLINK@' ]] || exit 0
/usr/bin/resolvectl default-route "$1" no
